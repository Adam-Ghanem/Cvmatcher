# Copy this file to .env for local development. Never commit .env.
CV_MATCHER_APP_ENV=development
CV_MATCHER_DATABASE_URL=postgresql://cvmatcher:cvmatcher@localhost:5432/cvmatcher
CV_MATCHER_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CV_MATCHER_RATE_LIMIT_REQUESTS_PER_MINUTE=120
CV_MATCHER_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=20
CV_MATCHER_EXPENSIVE_RATE_LIMIT_REQUESTS_PER_MINUTE=20
CV_MATCHER_RATE_LIMIT_WINDOW_SECONDS=60
# Local memory is development/test only. Production requires a configured shared backend.
CV_MATCHER_RATE_LIMIT_BACKEND=local
CV_MATCHER_RATE_LIMIT_FAIL_CLOSED_ON_BACKEND_ERROR=true
CV_MATCHER_LOG_LEVEL=INFO
CV_MATCHER_SESSION_HMAC_SECRET=development-only-change-me-before-production-32-bytes
CV_MATCHER_SESSION_TTL_HOURS=168
CV_MATCHER_MAX_UPLOAD_BYTES=10485760
CV_MATCHER_MAX_REQUEST_BODY_BYTES=262144
CV_MATCHER_PRIVATE_STORAGE_ROOT=.local-storage

# Public browser configuration only. Do not put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production must use a managed private object-store adapter before document intake is enabled.
# The Phase 2 local filesystem adapter is development/test only.

# Reserved for Phase 5 server-side AI integration. Do not add a real value until then.
# OPENAI_API_KEY=
